<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- SQL adapters and the Compose-validated seed executable are integration concerns, not unit-test coverage targets. The backend now compiles into TextRelay.Api. -->
          <Exclude>[TextRelay.Seed]*,[TextRelay.Api]Sms.Infrastructure.Persistence.*,[TextRelay.Api]Sms.Infrastructure.Observability.Postgres*Exporter,[TextRelay.Api]Sms.Infrastructure.Messaging.AlertEvaluationOutboxPublisher*,[TextRelay.Api]Sms.Infrastructure.Messaging.AlertEvaluationConsumer*,[TextRelay.Api]Sms.Infrastructure.Messaging.SmsSendOutboxPublisher*,[TextRelay.Api]Sms.Infrastructure.Messaging.SmsSendConsumer*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
